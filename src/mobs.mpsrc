//Восстановленный модуль ИИ мобов.
//Оригинальный исходник был утерян, модуль написан заново по образу
//прелекомпилированного mobs.class и вызовов из остальных модулей.
//Типы мобов:
// 1 - Зомби, 2 - Свинья, 3 - Овца(с шерстью), 4 - Курица, 5 - Крипер,
// 6 - Корова, 7 - Грибная корова, 8 - Паук, 9 - Свинозомби(злой),
// 10 - Свинозомби(нейтральный), 11 - Овца(остриженная)
unit mobs;

interface
 const
  max_mob=31;
  mob_maxani=3;
  mob_rnd_step=1000;//Период случайных событий ИИ (регенерация шерсти и т.п.)

 var
  zomb:array [0..1,0..9] of image;
  pig:array [0..1,0..2] of image;
  sheep:array [0..1,0..3] of image;
  chicken:array [0..1,0..2] of image;
  creeper:array [0..1,0..2] of image;
  cow1:array [0..1,0..2] of image;
  cow2:array [0..1,0..2] of image;
  spider:array [0..1,0..2] of image;
  pigman:array [0..1,0..9] of image;

  anim_del2:integer;
  load_mob_tex:boolean;

  procedure load_mob_info;
  procedure create_mob(mobtype, x, y:integer);
  procedure die_mob(i:integer);
  procedure update_ai;
  procedure draw_mobs;
  function mobw(id:integer):integer;
  function mobh(id:integer):integer;
  procedure usemob(x, y:integer);
  function coll_boom(x, y:integer):boolean;
  function mob_coll_boom(id, x, y:integer):boolean;

implementation
 uses vars, maps, phy, player, drop;

 var
  ai_tick:integer;

procedure load_mob_info;
 begin
  //Zombie
  mob_info[1].hp:=10;
  mob_info[1].velx:=1;
  mob_info[1].w:=8;
  mob_info[1].h:=32;
  mob_info[1].maxani:=3;
  //Pig
  mob_info[2].hp:=5;
  mob_info[2].velx:=1;
  mob_info[2].w:=28;
  mob_info[2].h:=22;
  mob_info[2].maxani:=mob_maxani;
  //Sheep
  mob_info[3].hp:=5;
  mob_info[3].velx:=1;
  mob_info[3].w:=28;
  mob_info[3].h:=24;
  mob_info[3].maxani:=mob_maxani;
  //Chicken
  mob_info[4].hp:=4;
  mob_info[4].velx:=1;
  mob_info[4].w:=16;
  mob_info[4].h:=16;
  mob_info[4].maxani:=mob_maxani;
  //Creeper
  mob_info[5].hp:=10;
  mob_info[5].velx:=1;
  mob_info[5].w:=16;
  mob_info[5].h:=26;
  mob_info[5].maxani:=mob_maxani;
  //Cow
  mob_info[6].hp:=10;
  mob_info[6].velx:=1;
  mob_info[6].w:=27;
  mob_info[6].h:=27;
  mob_info[6].maxani:=mob_maxani;
  //MushroomCow
  mob_info[7].hp:=10;
  mob_info[7].velx:=1;
  mob_info[7].w:=27;
  mob_info[7].h:=27;
  mob_info[7].maxani:=mob_maxani;
  //Spider
  mob_info[8].hp:=10;
  mob_info[8].velx:=1;
  mob_info[8].w:=32;
  mob_info[8].h:=16;
  mob_info[8].maxani:=mob_maxani;
  //ZombiePigMan
  mob_info[9].hp:=10;
  mob_info[9].velx:=1;
  mob_info[9].w:=8;
  mob_info[9].h:=32;
  mob_info[9].maxani:=3;
  //ZombiePigMan (Neutral)
  mob_info[10].hp:=10;
  mob_info[10].velx:=1;
  mob_info[10].w:=8;
  mob_info[10].h:=32;
  mob_info[10].maxani:=3;
  //Sheared sheep
  mob_info[11].hp:=5;
  mob_info[11].velx:=1;
  mob_info[11].w:=28;
  mob_info[11].h:=24;
  mob_info[11].maxani:=mob_maxani;
 end;

 function mobw(id:integer):integer;
  begin
   mobw:=mob_info[mob[id].m_type].w;
  end;

 function mobh(id:integer):integer;
  begin
   mobh:=mob_info[mob[id].m_type].h;
  end;

 procedure create_mob(mobtype, x, y:integer);
  var
   i:integer;
  begin
   if (mobtype<1) or (mobtype>11) then
    exit;
   for i:=0 to max_mob do
    if mob[i].m_type=0 then
     begin
      mob[i].m_type:=mobtype;
      mob[i].m_x:=x;
      mob[i].m_y:=y;
      mob[i].m_posi:=0;
      mob[i].m_velx:=0;
      mob[i].m_vely:=0;
      mob[i].m_ani:=0;
      mob[i].m_min_vely:=0;
      mob[i].m_hp:=mob_info[mobtype].hp;
      mob[i].m_del:=0;
      mob[i].m_fall:=false;
      mob[i].m_jmp:=false;
      mob[i].m_velani:=false;
      mob[i].m_int:=0;
      exit;
     end;
  end;

 procedure die_mob(i:integer);
  var
   x, y, t:integer;
  begin
   t:=mob[i].m_type;
   x:=mob[i].m_x+(mobw(i) div 2)-4;
   y:=mob[i].m_y+(mobh(i) div 2)-4;

   if t=1 then
    drop.create(190, random(3), x, y);//Гнилая плоть
   else
   if t=2 then
    drop.create(188, 1+random(2), x, y);//Сырая свинина
   else
   if t=3 then
    drop.create(32, 1, x, y);//Шерсть
   else
   if t=4 then
    begin
     drop.create(197, random(2), x, y);//Перо
     drop.create(177, random(2), x, y);//Яйцо
    end
   else
   if t=5 then
    drop.create(183, random(3), x, y);//Порох
   else
   if (t=6) or (t=7) then
    begin
     drop.create(199, 1+random(2), x, y);//Сырая говядина
     drop.create(198, random(2), x, y);//Кожа
    end
   else
   if t=8 then
    begin
     drop.create(167, random(3), x, y);//Нить
     drop.create(196, random(2), x, y);//Паучий глаз
    end
   else
   if (t=9) or (t=10) then
    drop.create(194, random(3), x, y);//Золотой самородок

   mob[i].m_type:=0;
  end;

 //Враждебные типы мобов
 function mob_hostile(t:integer):boolean;
  begin
   if (t=1) or (t=5) or (t=8) or (t=9) then
    mob_hostile:=true;
  end;

 //Поведение: выбор направления движения
 procedure mob_ai(i:integer);
  var
   t, dx:integer;
  begin
   t:=mob[i].m_type;
   dx:=player.getX-mob[i].m_x;
   if dx<0 then
    dx:=-dx;
   if mob_hostile(t) and (dx<240) then
    begin
     //Враждебные: преследуют игрока
     if player.getX>(mob[i].m_x+4) then
      mob[i].m_velx:=mob_info[t].velx
     else
     if player.getX<(mob[i].m_x-4) then
      mob[i].m_velx:=-mob_info[t].velx
     else
      mob[i].m_velx:=0;
    end
   else
    begin
     //Мирные (и далёкие враждебные): бродят случайно
     if mob[i].m_int<=0 then
      begin
       mob[i].m_int:=random(180)+60;
       mob[i].m_velx:=(random(3)-1)*mob_info[t].velx;
      end;
     //Овца отращивает шерсть обратно
     if (t=11) then
      if random(mob_rnd_step)=0 then
       mob[i].m_type:=3;
    end;
  end;

 //Горизонтальное перемещение с коллизией
 procedure mobvelxstep(i:integer);
  var
   tx:integer;
  begin
   if mob[i].m_velx<>0 then
    begin
     if mob[i].m_velx>0 then
      mob[i].m_posi:=1
     else
      mob[i].m_posi:=0;

     tx:=moveObjX(mob[i].m_x, mob[i].m_y, mobw(i), mobh(i), mob[i].m_velx);
     mob[i].m_x:=tx;

     if PhyGetColl then
      begin
       mob[i].m_velani:=false;
       //Упёрлись в стену - прыгаем, если стоим на земле
       if mob[i].m_fall then
        if mob[i].m_jmp=false then
         begin
          jumpObjY(mob[i].m_vely, 7, false);
          mob[i].m_vely:=PhyGetVelY;
          mob[i].m_jmp:=PhyGetJump;
         end;
      end
     else
      mob[i].m_velani:=true;
    end
   else
    mob[i].m_velani:=false;
  end;

 //Атака игрока при контакте
 procedure mob_attack(i:integer);
  begin
   if mob_hostile(mob[i].m_type) then
    if mob[i].m_int<=0 then
     if CollTwoObj(player.getX, player.getY, player.getW, player.getH, mob[i].m_x, mob[i].m_y, mobw(i), mobh(i)) then
      begin
       if gamemode<>1 then
        begin
         if mob[i].m_type=5 then
          hp:=hp-4
         else
          hp:=hp-2;
        end;
       mob[i].m_int:=40;
      end;
  end;

 //Один шаг ИИ моба
 procedure mob_step(i:integer);
  var
   bl:integer;
  begin
   if mob[i].m_int>0 then
    mob[i].m_int:=mob[i].m_int-1;

   //Гравитация
   calcGravY(mob[i].m_x, mob[i].m_y, mobw(i), mobh(i), CONST_PHY_ACC, mob[i].m_vely, CONST_PHY_MAXVEL, mob[i].m_jmp);
   mob[i].m_y:=PhyGetY;
   mob[i].m_vely:=PhyGetVelY;
   mob[i].m_jmp:=PhyGetJump;
   mob[i].m_fall:=PhyGetColl;

   //Плавание в воде и лаве
   bl:=getmap((mob[i].m_x+(mobw(i) div 2)) div 16, (mob[i].m_y+(mobh(i) div 2)) div 16);
   if (bl=50) or (bl=51) then
    mob[i].m_vely:=2;

   mob_ai(i);
   mobvelxstep(i);
   mob_attack(i);
  end;

 procedure update_ai;
  var
   i, dx, dy:integer;
  begin
   ai_tick:=ai_tick+1;

   //Анимация двигающихся мобов
   anim_del2:=anim_del2+1;
   if anim_del2>3 then
    begin
     anim_del2:=0;
     for i:=0 to max_mob do
      if mob[i].m_type>0 then
       begin
        if mob[i].m_velani then
         begin
          mob[i].m_ani:=mob[i].m_ani+1;
          if mob[i].m_ani>2 then
           mob[i].m_ani:=0;
         end
        else
         mob[i].m_ani:=0;
       end;
    end;

   for i:=0 to max_mob do
    if mob[i].m_type>0 then
     begin
      if mob[i].m_hp<1 then
       die_mob(i)
      else
      begin
       //Оптимизация: мобов рядом с игроком обновляем каждый кадр,
       //дальних - раз в 8 кадров (со сдвигом, чтобы не синхронно)
       dx:=mob[i].m_x-player.getX;
       if dx<0 then
        dx:=-dx;
       dy:=mob[i].m_y-player.getY;
       if dy<0 then
        dy:=-dy;

       if (dx<320) and (dy<320) then
        mob_step(i)
       else
        if ((ai_tick+i) and 7)=0 then
         mob_step(i);
      end;
     end;
  end;

 procedure draw_mobs;
  var
   i, x, y, t:integer;
  begin
   if load_mob_tex=false then
    exit;
   for i:=0 to max_mob do
    if mob[i].m_type>0 then
     begin
      x:=mob[i].m_x-camx;
      y:=mob[i].m_y-camy;
      t:=mob[i].m_type;
      //Рисуем только видимых мобов
      if (x>-32) and (x<getWidth) and (y>-32) and (y<getHeight) then
       begin
        if (t=1) or (t=9) then
         begin
          //Зомби и свинозомби: голова + тело
          if t=1 then
           begin
            drawimage(zomb[mob[i].m_posi, 0], x-6, y+10);
            drawimage(zomb[mob[i].m_posi, 6], x-2, y-2);
           end
          else
           begin
            drawimage(pigman[mob[i].m_posi, 0], x-6, y+10);
            drawimage(pigman[mob[i].m_posi, 6], x-2, y-2);
           end;
         end
        else
        if t=2 then
         drawimage(pig[mob[i].m_posi, mob[i].m_ani], x, y)
        else
        if (t=3) or (t=11) then
         begin
          drawimage(sheep[mob[i].m_posi, mob[i].m_ani], x, y);
          if t=3 then
           drawimage(sheep[mob[i].m_posi, 3], x+5, y+1);//Шерсть
         end
        else
        if t=4 then
         drawimage(chicken[mob[i].m_posi, mob[i].m_ani], x, y)
        else
        if t=5 then
         drawimage(creeper[mob[i].m_posi, mob[i].m_ani], x, y)
        else
        if t=6 then
         drawimage(cow1[mob[i].m_posi, mob[i].m_ani], x, y)
        else
        if t=7 then
         drawimage(cow2[mob[i].m_posi, mob[i].m_ani], x, y)
        else
        if t=8 then
         drawimage(spider[mob[i].m_posi, mob[i].m_ani], x, y);
       end;
     end;
  end;

 //Взаимодействие с мобом (использование блока, в котором стоит моб)
 procedure usemob(x, y:integer);
  var
   i:integer;
  begin
   for i:=0 to max_mob do
    if mob[i].m_type>0 then
     if CollTwoObj(x*16, y*16, 16, 16, mob[i].m_x, mob[i].m_y, mobw(i), mobh(i)) then
      begin
       //Стрижка овцы
       if mob[i].m_type=3 then
        begin
         mob[i].m_type:=11;
         drop.create(32, 1+random(2), mob[i].m_x+8, mob[i].m_y+8);
        end;
       exit;
      end;
  end;

 //Проверка: попадает ли блок (x, y) в игрока. Для урона от взрывов.
 function coll_boom(x, y:integer):boolean;
  begin
   coll_boom:=CollTwoObj(x*16, y*16, 16, 16, player.getX, player.getY, player.getW, player.getH);
  end;

 //Проверка: попадает ли блок (x, y) в моба id. Для урона от взрывов.
 function mob_coll_boom(id, x, y:integer):boolean;
  begin
   mob_coll_boom:=CollTwoObj(x*16, y*16, 16, 16, mob[id].m_x, mob[id].m_y, mobw(id), mobh(id));
  end;

initialization
 load_mob_info;
 ai_tick:=0;
end.
