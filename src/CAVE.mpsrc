  /*im:=ld_tex('terrain.png',path,'');
  iz:=0;
  for iy:=0 to 15 do
  for ix:=0 to 15 do
   begin
    if iz>maxBlockTex then break;
    tex[iz]:=rotate_image_from_image(im,ix*16,iy*16,16,16,0);
    tex8[iz]:=resize_image(tex[iz],8,8);
    iz:=iz+1;
   end;
  im:=ld_tex('items.png',path,'gui/');
  iz:=0;
  for iy:=0 to 15 do
  for ix:=0 to 15 do
   begin
    if iz>maxItemTex then break;
    item[iz]:=rotate_image_from_image(im,ix*16,iy*16,16,16,0);
    item8[iz]:=resize_image(item[iz],8,8);
    iz:=iz+1;
   end;*/
